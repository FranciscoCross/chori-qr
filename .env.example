# Copiar a .env y cambiar los valores. .env no se versiona.
# Generar PIN al azar: python3 -c "import secrets; print(secrets.token_urlsafe(9))"
STAFF_PIN=cambiar-pin-asador
ADMIN_PIN=cambiar-pin-admin

# Precio por chori (solo se muestra en la app y en el admin)
PRECIO_CHORI=6000

# Solo para publicar con dominios propios (compose.traefik.yaml).
# Sin estas variables todo se sirve en un host: /, /staff y /admin.
# HOST_USERS=choris.ejemplo.com
# HOST_STAFF=asador.ejemplo.com
# HOST_ADMIN=admin.ejemplo.com
